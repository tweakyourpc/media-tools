#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
PYTHON_BIN="${MEDIA_TOOLS_PYTHON:-$REPO_ROOT/.venv/bin/python}"

if [ $# -lt 1 ]; then
  exit 1
fi

for file in "$@"; do
  "$PYTHON_BIN" -m media_tools gif-to-mp4 "$file"
done
